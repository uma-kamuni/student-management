pipeline {

    agent any

    stages {

        stage('Checkout') {
            steps {
                git 'https://github.com/mayurpandit25/student-management.git'
            }
        }

        stage('Build') {
            steps {
                echo "Build is successful"
            }
        }

        stage('Test') {
            steps {
                echo "Test is successful"
            }
        }

        stage('Deploy') {
            steps {
                sh '''
                aws s3 cp target/*.war s3://umak.online/Artifact/student.war
                '''
            }
        }
    }
}