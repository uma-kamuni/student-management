pipeline {

    agent any

    stages {

        stage('Checkout') {
            steps {
                git 'https://github.com/uma-kamuni/student-management.git'
            }
        }

        stage('Build') {
            steps {
                echo "Build is successful"
            }
        }

        stage('Test') {
            steps {
                echo "Test is successful"
            }
        }

        stage('Deploy') {
            steps {
                echo "Deployment is successful"
            }
        }
    }

    post {

        success {
            script {

                def causes = currentBuild.getBuildCauses(
                    'hudson.model.Cause$UserIdCause'
                )

                def buildUser = causes ?
                    causes[0].userName :
                    'Automatic Trigger'

                slackSend(
                    channel: '#jenkins-test',
                    message: """Jenkins Build Notification

User: ${buildUser}
Job: ${env.JOB_NAME}
Build Number: #${env.BUILD_NUMBER}
Status: SUCCESS
Build URL: ${env.BUILD_URL}"""
                )
            }
        }

        failure {
            script {

                def causes = currentBuild.getBuildCauses(
                    'hudson.model.Cause$UserIdCause'
                )

                def buildUser = causes ?
                    causes[0].userName :
                    'Automatic Trigger'

                slackSend(
                    channel: '#jenkins-test',
                    message: """Jenkins Build Notification

User: ${buildUser}
Job: ${env.JOB_NAME}
Build Number: #${env.BUILD_NUMBER}
Status: FAILURE
Build URL: ${env.BUILD_URL}"""
                )
            }
        }
    }
}
