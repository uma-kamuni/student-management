pipeline {
    agent {
        label "worker"
    }

    environment {
        my_aws_credentials = credentials('aws-access')
    }

    tools {
        maven "maven"
    }

    stages {
        stage('checkout'){
            steps {
                git 'https://github.com/uma-kamuni/student-management.git'
                sh '''
                echo "clonning is successful"
                '''
            }
        }

        stage('Build'){
            steps {
                sh '''
                mvn clean package
                echo "build is successfull"
                '''
            }
            post {
                success {
                    archiveArtifacts artifacts: '**/target/*.war', fingerprint: true
                }
            }
        }

        stage('Artifact to S3'){
            steps {
                sh '''
                aws s3 cp target/*.war s3://umak.online/Artifact/student.war
                '''
            }
        }
    }

    post {

        success {
            script {

                def causes = currentBuild.getBuildCauses(
                    'hudson.model.Cause$UserIdCause'
                )

                def buildUser = causes ?
                    causes[0].userName :
                    'Automatic Trigger'

                slackSend(
                    channel: '#jenkins-test',
                    message: """Jenkins Build Notification

User: ${buildUser}
Job: ${env.JOB_NAME}
Build Number: #${env.BUILD_NUMBER}
Status: SUCCESS
Build URL: ${env.BUILD_URL}"""
                )
            }
        }

        failure {
            script {

                def causes = currentBuild.getBuildCauses(
                    'hudson.model.Cause$UserIdCause'
                )

                def buildUser = causes ?
                    causes[0].userName :
                    'Automatic Trigger'

                slackSend(
                    channel: '#jenkins-test',
                    message: """Jenkins Build Notification

User: ${buildUser}
Job: ${env.JOB_NAME}
Build Number: #${env.BUILD_NUMBER}
Status: FAILURE
Build URL: ${env.BUILD_URL}"""
                )
            }
        }
    }
}